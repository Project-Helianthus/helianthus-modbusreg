{
  "schema": "helianthus-modbusreg-huawei-catalogue-services/v1",
  "device_list_grammar": "A descriptor is a sequence of number=value character pairs separated by semicolons. The object length bounds the whole string. Integer-valued attributes are still textual values in this grammar.",
  "functions": [
    {"code":"03","purpose":"Read holding registers","status":"listed","boundary":"All selected interface editions list it; only mapped readable fields are candidates"},
    {"code":"06","purpose":"Write one register","status":"listed","boundary":"Function-level support does not prove that a particular one-word field accepts it"},
    {"code":"10","purpose":"Write multiple registers","status":"listed","boundary":"Field access, compound shape and control conditions still apply"},
    {"code":"2B/0E","purpose":"Device identification","status":"listed","boundary":"Basic identity and the private device list are different requests"},
    {"code":"41","purpose":"gateway file subservices","status":"not established"},
    {"code":"04","purpose":"read input registers","status":"not established"},
    {"code":"17","purpose":"raw function 17 hexadecimal (decimal 23)","status":"not established"},
    {"code":"11","purpose":"raw function 11 hexadecimal (decimal 17, the standard serial Report Server ID)","status":"not established"}
  ],
  "exceptions": [
    {"code":"01","meaning":"Requested function is not supported in that context","families":["EMMA","S-Dongle","SmartLogger"]},
    {"code":"02","meaning":"Requested address or span is not valid","families":["EMMA","S-Dongle","SmartLogger"]},
    {"code":"03","meaning":"The request data violates an accepted value/shape rule","families":["EMMA","S-Dongle","SmartLogger"]},
    {"code":"04","meaning":"Device processing failed","families":["EMMA","S-Dongle","SmartLogger"]},
    {"code":"05","meaning":"acknowledged long operation","families":["EMMA","SmartLogger"]},
    {"code":"06","meaning":"Device is busy","families":["EMMA","S-Dongle","SmartLogger"]},
    {"code":"08","meaning":"memory/parity failure","families":["EMMA","SmartLogger"]},
    {"code":"0A","meaning":"gateway path unavailable","families":["EMMA","SmartLogger"]},
    {"code":"0B","meaning":"downstream target did not respond","families":["EMMA","SmartLogger"]},
    {"code":"80","meaning":"Vendor permission refusal","families":["EMMA","S-Dongle","SmartLogger"]},
    {"code":"81","meaning":"A function-specific parameter failed validation; this is distinct from the generic PDU-shape error 03","families":["EMMA"]},
    {"code":"A1","meaning":"External-meter installation selection is refused when no external meter is detected, or when that external meter is assigned to a third-party inverter","families":["EMMA"]},
    {"code":"A2","meaning":"Manual system-time setting is invalid while NTP is the time source","families":["EMMA"]},
    {"code":"B0","meaning":"Export preparation is refused during upgrade; the wording does not define a file-transfer service","families":["EMMA"]}
  ],
  "list_objects": [
    {"object":"87","meaning":"Device count associated with the source’s RS485-address/network-element context"},
    {"object":"88","meaning":"First device description"},
    {"object":"89","meaning":"Second device in most editions"},
    {"object":"FF","meaning":"Described as device 120"}
  ],
  "attributes": [
    {"number":1,"meaning":"Model text","differences":"An example model is not an exhaustive applicability list"},
    {"number":2,"meaning":"Device software text","differences":"Keep distinct from the interface edition and from operator-supplied firmware"},
    {"number":3,"meaning":"Interface-protocol version text","differences":"Not a universal capability bitmap"},
    {"number":4,"meaning":"Serial/ESN text","differences":"Use as supplied; normalization and padding rules are not universal"},
    {"number":5,"meaning":"Source-assigned device number","differences":"route reconciliation is still necessary."},
    {"number":6,"meaning":"Edition-dependent"},
    {"number":7,"meaning":"Undefined/N/A","differences":"Preserve raw if present"},
    {"number":8,"meaning":"Product-type text where defined","differences":"EMMA examples include HEMS and SUN2000; do not infer all possible types"},
    {"number":9,"meaning":"Parent-device information in newer SmartLogger","differences":"EMMA examples show 9=0 without defining attribute 9 in their dictionary"},
    {"number":10,"meaning":"Registration-code text in newer SmartLogger"}
  ],
  "limits": [
    {"id":"standard-pdu","origin":"standard","rule":"A Modbus PDU holds at most 253 bytes.","bytes":253},
    {"id":"standard-tcp-adu","origin":"standard","rule":"A Modbus TCP ADU holds at most 260 bytes, including the seven-byte MBAP header.","bytes":260},
    {"id":"vendor-tcp-frame","origin":"vendor","rule":"Every gateway interface edition states a 256-byte TCP frame maximum, which conflicts with its own maximum read and write counts.","bytes":256},
    {"id":"vendor-read-quantity","origin":"vendor","rule":"Every edition permits FC03 reads of 1 to 125 words.","words":125},
    {"id":"vendor-write-quantity","origin":"vendor","rule":"Every edition prints FC10 counts of 0 to 123 words; the standard requires at least one register.","words":123},
    {"id":"fc03-response-123","origin":"standard","rule":"An FC03 TCP response occupies 9 + 2N bytes including MBAP.","words":123,"bytes":255},
    {"id":"fc03-response-124","origin":"standard","rule":"An FC03 TCP response occupies 9 + 2N bytes including MBAP.","words":124,"bytes":257},
    {"id":"fc03-response-125","origin":"standard","rule":"An FC03 TCP response occupies 9 + 2N bytes including MBAP.","words":125,"bytes":259},
    {"id":"fc10-request-121","origin":"standard","rule":"An FC10 TCP request occupies 13 + 2N bytes including MBAP.","words":121,"bytes":255},
    {"id":"fc10-request-123","origin":"standard","rule":"An FC10 TCP request occupies 13 + 2N bytes including MBAP.","words":123,"bytes":259},
    {"id":"client-read-cap","origin":"client_policy","rule":"Cap a read at 123 words: the response fits the conservative gateway arithmetic of 255 bytes; the cap guarantees neither block support nor value alignment and is no vendor guarantee.","words":123,"bytes":255},
    {"id":"client-write-cap","origin":"client_policy","rule":"Cap a multiple write at 121 words: the request occupies 255 bytes; the cap grants no write permission and is no vendor guarantee.","words":121,"bytes":255}
  ],
