  "gates": [
    {"id":"EXACT_MODEL_AND_EDITION","meaning":"Exact supported-model row and explicit source firmware minimum, if present, select this edition; no chronology-derived gate."},
    {"id":"ROUTE_AND_FRESHNESS","meaning":"Correct logical endpoint, successful well-formed FC03 response, current data and source validity are independently required; timeout is not absence."},
    {"id":"EMMA_UNIT0_ENDPOINT","meaning":"LB-C10p59 section3.3 targets EMMA at logical ID0; these are not inverter identity/telemetry rows."},
    {"id":"EMMA_COMMON_DEVICE_ROUTE","meaning":"LB-C10p79–80 public registers describe devices associated through EMMA; do not transplant the previous section’s fixed unit0 rule to every associated device."},
    {"id":"EMMA_ASSOCIATED_COMPONENTS","meaning":"Bind plant/storage/load values to EMMA configuration and associated components; a readable aggregate is not active hardware proof."},
    {"id":"EMMA_DISCOVERY_RESULT","meaning":"Interpret counts with the documented search-state result and component identity."},
    {"id":"EMMA_VALID_PLANT_STATE","meaning":"Preserve0xFFFF as no displayed state; do not map it to a running mode."},
    {"id":"EMMA_INTERNAL_SENSOR_VALIDITY","meaning":"Built-in EMMA sensor channel; verify sensor context and physical topology separately."},
    {"id":"EMMA_EXTERNAL_SENSOR_VALIDITY","meaning":"External EMMA sensor channel; verify associated meter and physical topology separately."},
    {"id":"PV_COUNT_AND_CHANNEL_LAYOUT","meaning":"Use exact model/string-count and documented channel map; C81 sparse32262/32314 layout is independent from32016/32344 layouts."},
    {"id":"MPPT_COUNT_AND_CHANNEL_LAYOUT","meaning":"Use exact model MPPT count and source channel identities, not register readability."},
    {"id":"EXACT_STATE_DICTIONARY","meaning":"Only documented exact-profile states/bits may receive labels; unknown/reserved values stay UNKNOWN."},
    {"id":"EXACT_ALARM_DICTIONARY","meaning":"Use exact source alarm/cause/bit table; C81 uses separate50000–50016 bank, other profiles cannot inherit it."},
    {"id":"ENERGY_TIME_AND_RESET_BOUNDARY","meaning":"Preserve period/cumulative meaning and source collection time; do not infer reset or local-midnight behavior beyond documentation."},
    {"id":"SOURCE_TIME_CONVENTION","meaning":"Keep source local/epoch convention and collection/start/stop meaning; timezone conversion not inferred."},
    {"id":"EXACT_OUTPUT_TOPOLOGY","meaning":"Apply source wiring predicates; HB3-wire line versus4-wire phase differs from L/N and split-phase re-labeling in HD/common maps."},
    {"id":"COHERENT_DISPATCH_SNAPSHOT","meaning":"Read whole documented group/block atomically enough for its semantics."},
    {"id":"CELLULAR_MODEL_AND_MODULE_PRESENT","meaning":"Module/model applicability and state required; module status does not prove successful network reachability."},
    {"id":"FEATURE_LICENSE_NOT_HARDWARE","meaning":"License eligibility/status/expiration differs from installed hardware, configured feature and live operation."},
    {"id":"STORAGE_APPLICABILITY","meaning":"Honor source battery-vendor support columns and complete footnotes; no vendor support inherited from another profile."},
    {"id":"STORAGE_RUNNING_AND_COMPONENT_IDENTITY","meaning":"One attached unit maps to unit1; where documented, a second LUNA unit maps to unit2. Active running/identity is a separate runtime gate."},
    {"id":"PACK_SLOT_AND_VALIDITY","meaning":"Require associated storage unit and actual pack slot; pack enum cannot be borrowed from unit enum."},
    {"id":"PARALLEL_SYSTEM_SCOPE","meaning":"preserve compound packet and exact request enum."},
    {"id":"METER_ONLINE_TYPE_AND_MODEL","meaning":"Require exact-source online/type/model association and valid phase topology;37113 sign alone does not establish a meter."},
    {"id":"OPTIMIZER_MODEL_ASSOCIATION_AND_ONLINE","meaning":"Use documented model/grid-code support, device totals/online state and source metadata/file association; no active optimizer inferred."},
    {"id":"MBUS_MODEL_AND_ASSOCIATED_DEVICE","meaning":"Identify DC-MBUS endpoint/component; no optimizer or network presence inferred from status register alone."},
    {"id":"DONGLE_SCOPE_NOT_INVERTER_HARDWARE","meaning":"Dongle-related observations are separate component state; no gateway/session qualification inferred."},
    {"id":"TRACKER_CONTROLLER_SCOPE","meaning":"Require exact associated tracker/controller and its own model/enum dictionary; dual-axis count ceiling is8 where documented."},
    {"id":"DIAGNOSTIC_SCOPE_NOT_PUBLIC_PROCESS_STATE","meaning":"Preserve maintenance/R&D instrumentation intent; undefined internal fields are not stable plant-state abstractions."},
    {"id":"NETWORK_INTERFACE_SCOPE","meaning":"Management/WLAN/NTP/FE context is interface-specific; no route/session reachability inferred."},
    {"id":"PID_SINGLE_STAGE_SCOPE","meaning":"PID-reported single-stage context applies where explicitly stated."},
    {"id":"IDENTITY_NOT_FEATURE_SUPPORT","meaning":"Version/name/component records identify documentary objects; absence or readable placeholder does not establish support."},
    {"id":"MPPT_PREDICTION_CONTEXT","meaning":"Prediction is not measured output and does not establish a supported/active MPPT count."},
    {"id":"COMMERCIAL_POSITIVE_APPLICABILITY_UNESTABLISHED","meaning":"Commercialp7 explicitly excludes SUN2000V100R001/V200R001/V200R002 and SUN2000HAV100R001. Positive model applicability remains missing."},
    {"id":"STAR_MODEL_OR_GRID_CODE","meaning":"Source star-marked rows depend on model or grid code; exact support must be established, not assumed for all supported-model rows."}
