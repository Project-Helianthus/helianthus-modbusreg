    {"id":"TRACKER_CONTROLLER_SCOPE","meaning":"Require exact associated tracker/controller and its own model/enum dictionary; dual-axis count ceiling is8 where documented."},
    {"id":"DIAGNOSTIC_SCOPE_NOT_PUBLIC_PROCESS_STATE","meaning":"Preserve maintenance/R&D instrumentation intent; undefined internal fields are not stable plant-state abstractions."},
    {"id":"NETWORK_INTERFACE_SCOPE","meaning":"Management/WLAN/NTP/FE context is interface-specific; no route/session reachability inferred."},
    {"id":"PID_SINGLE_STAGE_SCOPE","meaning":"PID-reported single-stage context applies where explicitly stated."},
    {"id":"IDENTITY_NOT_FEATURE_SUPPORT","meaning":"Version/name/component records identify documentary objects; absence or readable placeholder does not establish support."},
